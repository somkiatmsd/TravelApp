rules_version = '2';

// Wanderpin security rules
// - Places are private to their owner.
// - Profiles: public ones are visible to every signed-in user; private ones only to friends.
// - Friendship needs a request and the other person's approval.
// - A plan is visible to its members. The owner can only add people who are their friends.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isFriend(a, b) { return exists(/databases/$(database)/documents/profiles/$(a)/friends/$(b)); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function membersChangedOnlyForMe() {
      return request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()]);
    }
    function optString(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'nameLower', 'photo', 'thumb', 'bio', 'isPublic', 'stats', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.isPublic is bool
        && optString(d, 'nameLower', 60)
        && optString(d, 'photo', 300000)
        && optString(d, 'thumb', 30000)
        && optString(d, 'bio', 300)
        && (!('stats' in d) || d.stats is map);
    }

    function validPlan(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.start is string && d.end is string
        && d.memberIds is list && d.memberIds.size() <= 50
        && d.members is map;
    }

    match /users/{userId}/places/{placeId} {
      allow read, write: if signedIn() && me() == userId;
    }

    match /profiles/{uid} {
      allow read: if signedIn() && (resource.data.isPublic == true || me() == uid || isFriend(uid, me()));
      allow create, update: if signedIn() && me() == uid && validProfile(request.resource.data);
      allow delete: if signedIn() && me() == uid;

      // profiles/{uid}/friends/{fid}: fid is a friend of uid.
      // Readable by uid and by uid's friends (to see friends of friends; their profiles keep their own rules).
      // Only the person who received a request can create the two friendship docs (when accepting).
      match /friends/{fid} {
        allow read: if signedIn() && (me() == uid || isFriend(uid, me()));
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['since'])
          && (
            (me() == uid && exists(/databases/$(database)/documents/friendRequests/$(fid + '_' + uid)))
            || (me() == fid && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + fid)))
          );
        allow delete: if signedIn() && (me() == uid || me() == fid);
      }
    }

    // cards/{uid}: name + small photo only, readable by any signed-in user,
    // so friends of friends can show who someone is even when their profile is private.
    match /cards/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'thumb', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && optString(request.resource.data, 'thumb', 30000);
      allow delete: if signedIn() && me() == uid;
    }

    // calls/{from}_{to}: "I'm calling you" — a friend rings a friend; the callee sees it while the app is open.
    function validCall(d) {
      return d.keys().hasOnly(['from', 'to', 'fromName', 'fromThumb', 'room', 'at'])
        && d.from == me() && d.to is string && d.to != me()
        && d.room is string && d.room.size() <= 200
        && d.fromName is string && d.fromName.size() <= 60
        && optString(d, 'fromThumb', 30000)
        && isFriend(me(), d.to);
    }
    match /calls/{cid} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && validCall(request.resource.data) && cid == me() + '_' + request.resource.data.to;
      allow update: if signedIn() && resource.data.from == me() && validCall(request.resource.data) && cid == me() + '_' + request.resource.data.to;
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // friendRequests/{from}_{to}
    match /friendRequests/{rid} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'fromThumb', 'createdAt'])
        && request.resource.data.from == me()
        && request.resource.data.to is string
        && request.resource.data.to != me()
        && rid == me() + '_' + request.resource.data.to
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && optString(request.resource.data, 'fromThumb', 30000)
        && !isFriend(me(), request.resource.data.to)
        && get(/databases/$(database)/documents/profiles/$(request.resource.data.to)).data.isPublic == true;
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    match /plans/{planId} {
      allow read: if signedIn() && me() in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()]
        && validPlan(request.resource.data);

      allow delete: if signedIn() && resource.data.ownerId == me();

      allow update: if signedIn() && validPlan(request.resource.data) && (
        // owner: anything else (incl. closing the trip: finishedAt / outcome); keeps ownership and stays a member; members can be removed,
        // and can be added one at a time (named in lastAdded) only if they are the owner's friend
        (resource.data.ownerId == me()
          && request.resource.data.ownerId == me()
          && me() in request.resource.data.memberIds
          && (
            resource.data.memberIds.toSet().hasAll(request.resource.data.memberIds)
            || (request.resource.data.lastAdded is string
              && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.resource.data.lastAdded].toSet())
              && isFriend(me(), request.resource.data.lastAdded))
          ))

        // member: edit trip content
        || (me() in resource.data.memberIds
          && changed().hasOnly(['title', 'start', 'end', 'color', 'note', 'placeIds', 'stops', 'call', 'updatedAt'])
          && (!('call' in request.resource.data) || request.resource.data.call is map))

        // member: refresh own name/photo shown in the plan
        || (me() in resource.data.memberIds
          && changed().hasOnly(['members', 'updatedAt'])
          && membersChangedOnlyForMe())

        // member (not owner): leave the plan
        || (me() in resource.data.memberIds
          && resource.data.ownerId != me()
          && changed().hasOnly(['memberIds', 'members', 'updatedAt'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([me()].toSet())
          && membersChangedOnlyForMe())
      );
    }
  }
}
